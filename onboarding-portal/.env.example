# Postgres (Neon/Supabase on Vercel: append ?sslmode=require)
DATABASE_URL=postgres://localhost:5432/onboarding

# Public base URL, used in emailed links
APP_URL=http://localhost:3000

# Signs staff sessions. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Comma-separated email domains allowed to sign in as staff
ALLOWED_EMAIL_DOMAINS=orthosyneticsinc.com

# Email via Resend. Leave RESEND_API_KEY empty in dev: emails print to the server console.
RESEND_API_KEY=
EMAIL_FROM=PatientPath Onboarding <onboarding@yourpatientpath.com>
# Where "client is stuck" / "client finished" alerts go
STAFF_NOTIFY_EMAIL=marketing@orthosyneticsinc.com

# What clients grant access to (shown in their instructions)
AGENCY_NAME=PatientPath
META_BUSINESS_ID=
AGENCY_GOOGLE_EMAIL=

# Reminder cron (Vercel sends this as a Bearer token automatically when set)
CRON_SECRET=
REMINDER_INTERVAL_DAYS=3
